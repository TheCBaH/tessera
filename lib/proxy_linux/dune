; The static browser-asset generator: reads web/ at build time and emits
; web_assets.ml, so tessera-proxy (an installed executable) never needs a source checkout nearby to
; serve its own page. Unlike test/web_render_playwright/gen_goldens.ml (an explicit, reviewed developer
; command), this rule always runs as part of the ordinary build -- there is no committed output to
; review, only the always-current web/ sources it is generated from.

(executable
 (name gen_web_assets)
 (modes exe)
 (modules gen_web_assets))

(rule
 (targets web_assets.ml)
 (deps
  gen_web_assets.exe
  ../../web/index.html
  ../../web/tessera-decode.js
  ../../web/tessera-driver.js
  ../../web/tessera-html-target.js
  ../../web/proxy-input.js
  ../../web/tessera.css
  ../../web/proxy-web.js
  ../../web/fonts/jetbrains-mono-latin-400-normal.woff2)
 (action
  (with-stdout-to
   web_assets.ml
   (run ./gen_web_assets.exe ../../web))))

; The composition root executable (proxy.md implementation order step 5). Kept as its own stanza,
; gated to Linux, since it is the only unit in this package that names the real
; Tessera_proxy_platform_linux binding rather than staying generic over Platform.S.

(executable
 (name proxy)
 (package tessera_proxy_linux)
 (public_name tessera-proxy)
 (modules proxy)
 (libraries
  tessera_foundation
  tessera_proxy_linux
  tessera_proxy_observer
  tessera_proxy_platform
  tessera_proxy_platform_linux
  lwt
  lwt.unix
  unix)
 (enabled_if
  (= %{system} linux)))
