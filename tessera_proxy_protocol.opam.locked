opam-version: "2.0"
name: "tessera_proxy_protocol"
version: "dev"
synopsis: "Versioned observer wire protocol for the Tessera proxy"
description:
  "A length-delimited codec for the proxy's traffic/resize/effect records, authoritative snapshot, and gap notification, independent of any transport."
license: "MIT"
depends: [
  "base-bigarray" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "dune" {= "3.24.2"}
  "ocaml" {= "4.14.3"}
  "ocaml-base-compiler" {= "4.14.3"}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "tessera_proxy_observer" {= "dev"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]