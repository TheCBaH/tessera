opam-version: "2.0"
name: "tessera_unix"
version: "dev"
synopsis: "Unix scheduler adapter for the Tessera portable terminal core"
description:
  "Serialises Unix file-descriptor byte reads and validated resize requests through Tessera.Session.ingest, keeping per-direction writes ordered."
license: "MIT"
depends: [
  "base-bigarray" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "dune" {= "3.24.2"}
  "ocaml" {= "4.14.3"}
  "ocaml-base-compiler" {= "4.14.3"}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]