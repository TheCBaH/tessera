opam-version: "2.0"
name: "tessera_proxy_linux"
version: "dev"
synopsis: "Linux terminal proxy composition root for Tessera"
description:
  "Wires Tessera_unix.Unix_adapter, Tessera_proxy_platform, Tessera_proxy_observer, and Tessera_proxy_protocol's socket server into a proxy session and the tessera-proxy executable."
license: "MIT"
depends: [
  "base-bigarray" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "dune" {= "3.24.2"}
  "ocaml" {= "4.14.3"}
  "ocaml-base-compiler" {= "4.14.3"}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "tessera_proxy_observer" {= "dev"}
  "tessera_proxy_platform" {= "dev"}
  "tessera_proxy_protocol" {= "dev"}
  "tessera_unix" {= "dev"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]