opam-version: "2.0"
name: "tessera_proxy_linux"
version: "dev"
synopsis: "Linux terminal proxy composition root for Tessera"
description:
  "Wires Tessera_lwt.Lwt_adapter, Tessera_proxy_platform, Tessera_proxy_observer, and Tessera_proxy_protocol's socket server into an Lwt-driven proxy session and the tessera-proxy executable."
license: "MIT"
depends: [
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "dune" {= "3.24.2"}
  "dune-configurator" {= "3.24.2"}
  "lwt" {= "6.1.2"}
  "ocaml" {= "4.14.3"}
  "ocaml-base-compiler" {= "4.14.3"}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlfind" {= "1.9.8"}
  "ocplib-endian" {= "1.2"}
  "tessera_lwt" {= "dev"}
  "tessera_proxy_observer" {= "dev"}
  "tessera_proxy_platform" {= "dev"}
  "tessera_proxy_protocol" {= "dev"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]