@@ -95,19 +114,31 @@
   type (_, _) eq = Equal : ('a, 'a) eq
   module Id = struct
     type _ id = ..
-    module type ID = sig type t type _ id += Id : t id end
+    module type ID = sig type t type _ id += Id : t id val uid : int end
     type 'a t = (module ID with type t = 'a)
 
+    (* Melange overlay: upstream derives [uid] from [Obj.Extension_constructor.id
+       (Obj.Extension_constructor.of_val A.Id)], which Melange's [Obj] does not
+       support (it raises at run time -- see this file's provenance header). [uid]
+       is only ever used as a fast, collision-tolerant [Dict] lookup key (see
+       jsont.ml's [Dict.mem]/[add]/[find]): a hit is always confirmed by
+       [provably_equal]'s GADT match before being trusted, so [uid] itself only
+       needs to be distinct per [make] call, not derived from any particular
+       runtime representation. A plain monotonic counter, stamped into the
+       generated module at [make] time, satisfies that under every backend. *)
+    let counter = ref 0
+
     let make (type a) () : a t =
-      (module struct type t = a type _ id += Id : t id end)
+      incr counter;
+      let uid = !counter in
+      (module struct type t = a type _ id += Id : t id let uid = uid end)
 
     let provably_equal
         (type a b) ((module A) : a t) ((module B) : b t) : (a, b) eq option
       =
       match A.Id with B.Id -> Some Equal | _ -> None
 
-    let uid (type a) ((module A) : a t) =
-      Obj.Extension_constructor.id (Obj.Extension_constructor.of_val A.Id)
+    let uid (type a) ((module A) : a t) = A.uid
   end
